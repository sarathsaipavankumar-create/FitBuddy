**/application-local.properties
**/application-local.yml
application-local.properties
application-local.yml
*.env
*.env.local
!*.env.example
secrets.properties

# Log Files & Crash Dumps
*.log
logs/
**/logs/
*.stackdump
hs_err_pid*

# IDE & Editor Artifacts
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating System Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Node / Package Manager Files (if applicable)
node_modules/
dist/
build/
.npm
